namespace tests_blitzbuffers

struct Entity {
  id: u32
  type: EntityType
  position: PositionEnum
}

enum EntityType {
    Player
    Enemy
    Neutral
}

enum PositionEnum {
    NoPosition
    Position(Position)
    TuplePosition(f32, f32, f32)
    InlinePosition {
        x: f32
        y: f32
        z: f32
    }
}

struct Position {
    x: f32
    y: f32
    z: f32
}
